{
  "name": "taland",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:setup": "mkdir -p data && DATABASE_URL=file:$PWD/data/taland.db prisma db push && DATABASE_URL=file:$PWD/data/taland.db tsx prisma/seed.ts",
    "db:seed": "DATABASE_URL=file:$PWD/data/taland.db tsx prisma/seed.ts",
    "db:push": "DATABASE_URL=file:$PWD/data/taland.db prisma db push",
    "check": "tsx scripts/self-check.ts",
    "test:flow": "tsx scripts/e2e-flow.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.0",
    "puppeteer-core": "^24.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
