# Скопируйте в .env и заполните. Секреты в репозиторий не коммитить.
# Для SQLite надёжнее абсолютный путь: file:/полный/путь/taland/data/taland.db
# Команды npm run db:setup / db:seed сами подставляют file:$PWD/data/taland.db
DATABASE_URL="file:./data/taland.db"

# Пароль входа в /admin. Обязательно замените перед публикацией.
ADMIN_PASSWORD="change-me"

# http://localhost без HTTPS. На боевом сайте за HTTPS поставьте true.
COOKIE_SECURE="false"

# Публичный адрес сайта. ЮKassa вернёт покупателя сюда после оплаты.
PUBLIC_BASE_URL="http://localhost:3000"

# --- ЮKassa, только тестовый магазин ---
# Боевые ключи не вставлять, пока сознательно не включите приём.
# Тест и бой — разные магазины в личном кабинете ЮKassa, адрес API один.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Пока true, код считает ключи тестовыми. false без YOOKASSA_ALLOW_LIVE блокирует платежи.
YOOKASSA_TEST_MODE="true"
# Явное разрешение боевых платежей. Оставьте false, пока юрист и касса не готовы.
YOOKASSA_ALLOW_LIVE="false"

# Чек 54-ФЗ в теле платежа. Чеки выпускает сервис «Чеки от ЮKassa».
YOOKASSA_SEND_RECEIPT="true"
# 1 — без НДС. Полный список кодов: документация ЮKassa, справочник 54-ФЗ.
YOOKASSA_VAT_CODE="1"
# full_prepayment — полная предоплата (онлайн до выдачи заказа).
YOOKASSA_PAYMENT_MODE="full_prepayment"
# Необязательно. Код системы налогообложения, если в магазине их несколько.
YOOKASSA_TAX_SYSTEM_CODE=""
# Признак расчёта в интернете в чеке. Для онлайн-оплаты оставьте true.
YOOKASSA_RECEIPT_INTERNET="true"

# Если ключей нет, страница оплаты показывает тестовое подтверждение.
# Поставьте false, когда подключена настоящая ЮKassa.
ALLOW_MOCK_PAYMENTS="true"

# Вход клиента.
# dev — код показывается на экране тому, кто запросил вход (без SMS).
# sms — код уходит через SMS_PROVIDER, на экране его нет.
AUTH_MODE="dev"
# Заготовка шлюза: SMS_PROVIDER=http, SMS_HTTP_URL, необязательно SMS_HTTP_TOKEN.
SMS_PROVIDER=""
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
# Необязательный фиксированный код для своих автотестов. Пусто — случайные 4 цифры.
DEV_OTP_CODE=""

# --- Метрики для рекламы (вшиваются при сборке: после изменения — пересобрать) ---
# Яндекс Метрика: номер счётчика. Цели и электронная коммерция — METRICS.md.
NEXT_PUBLIC_YM_ID=""
# VK Реклама: ID пикселя (Top.Mail.Ru), например 3612345.
NEXT_PUBLIC_VK_PIXEL_ID=""
# GA4 — по желанию, G-XXXXXXX. Для рекламы в РФ не нужен.
NEXT_PUBLIC_GA4_ID=""
