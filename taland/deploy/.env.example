# Скопировать в deploy/.env на сервере. В git не класть.
TALAND_DOMAIN=taland.example.ru
# Имя docker-сети, в которой traefik видит контейнеры (смотреть: docker inspect traefik-traefik-1)
TRAEFIK_NETWORK=
# Точка входа HTTPS в traefik (обычно websecure или https)
TRAEFIK_ENTRYPOINT=
# Имя certresolver Let's Encrypt в конфиге traefik
TRAEFIK_CERTRESOLVER=
# Логин:хеш для пароля стенда. Сгенерировать: htpasswd -nbB taland 'ПАРОЛЬ' | sed -e 's/\$/\$\$/g'
TALAND_BASIC_AUTH=
